# Copie para .env.local e preencha com a saída de `npm run db:status`.
# Nunca faça commit de valores reais.

# URL da API do Supabase (local: http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=
# Chave publicável (pode ir ao navegador).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (service role). Somente servidor; nunca use o prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# URL pública do site. Se vazia, usa http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
# "true" exibe o botão de login com Google; qualquer outro valor o oculta.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=

# Login com Google (lido pelo CLI do Supabase, em supabase/config.toml).
# Só preencha quando houver credenciais OAuth e ative [auth.external.google].
# SUPABASE_AUTH_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_GOOGLE_SECRET=
